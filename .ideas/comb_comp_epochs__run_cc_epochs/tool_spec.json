{
    "key": "comb_comp_epochs__run_cc_epochs",
    "name": "Combine and Compare Neural Activity Across Epochs",
    "schema_version": "3.0.0",
    "container_image": {
        "repository": "platform/neural-analysis",
        "label": "1.0.3"
    },
    "command": {
        "file_path": "analysis/comb_comp_epochs.py",
        "entry_point": "run_cc_epochs_ideas_wrapper",
        "program_type": "PYTHON"
    },
    "params": [
        {
            "key": "group1_activity_csv_files",
            "name": "Group 1 Activity Files",
            "required": true,
            "description": "CSV files containing activity_per_epoch_data outputs for Group 1 (produced by epoch_activity). At least two files are required.",
            "type": {
                "param_type": "ToolPathParam",
                "multiple": true,
                "file_formats": [
                    "csv"
                ]
            },
            "group": "Group 1 Input Files"
        },
        {
            "key": "group1_correlation_csv_files",
            "name": "Group 1 Correlation Files",
            "required": false,
            "description": "Correlation outputs for Group 1. Accepts either CSV files (correlations_per_epoch_data.csv) or H5 files (pairwise_correlation_heatmaps.h5) from epoch_activity.",
            "type": {
                "param_type": "ToolPathParam",
                "multiple": true,
                "file_formats": [
                    "csv",
                    "h5"
                ]
            },
            "group": "Group 1 Input Files"
        },
        {
            "key": "group1_modulation_csv_files",
            "name": "Group 1 Modulation Files",
            "required": false,
            "description": "CSV files containing modulation_vs_baseline_data outputs for Group 1 (produced by epoch_activity).",
            "type": {
                "param_type": "ToolPathParam",
                "multiple": true,
                "file_formats": [
                    "csv"
                ]
            },
            "group": "Group 1 Input Files"
        },
        {
            "key": "group2_activity_csv_files",
            "name": "Group 2 Activity Files",
            "required": false,
            "description": "CSV files containing activity_per_epoch_data outputs for Group 2 (produced by epoch_activity). At least two files are required when provided.",
            "type": {
                "param_type": "ToolPathParam",
                "multiple": true,
                "file_formats": [
                    "csv"
                ]
            },
            "group": "Group 2 Input Files"
        },
        {
            "key": "group2_correlation_csv_files",
            "name": "Group 2 Correlation Files",
            "required": false,
            "description": "Correlation outputs for Group 2. Accepts either CSV files (correlations_per_epoch_data.csv) or H5 files (pairwise_correlation_heatmaps.h5) from epoch_activity. Required when Group 1 provides correlation files and Group 2 is provided.",
            "type": {
                "param_type": "ToolPathParam",
                "multiple": true,
                "file_formats": [
                    "csv",
                    "h5"
                ]
            },
            "group": "Group 2 Input Files"
        },
        {
            "key": "group2_modulation_csv_files",
            "name": "Group 2 Modulation Files",
            "required": false,
            "description": "CSV files containing modulation_vs_baseline_data outputs for Group 2 (produced by epoch_activity). Required when Group 1 provides modulation files and Group 2 is provided.",
            "type": {
                "param_type": "ToolPathParam",
                "multiple": true,
                "file_formats": [
                    "csv"
                ]
            },
            "group": "Group 2 Input Files"
        },
        {
            "key": "epoch_names",
            "name": "Name of Epochs",
            "required": true,
            "description": "Comma-separated epoch names matching the epochs in your input CSVs. Order determines plot ordering.",
            "type": {
                "param_type": "ToolStringParam",
                "default": "Baseline, Drug, Washout"
            },
            "group": "Epoch Configuration"
        },
        {
            "key": "group1_name",
            "name": "Name of the first group",
            "required": true,
            "description": "Name of the first group",
            "type": {
                "param_type": "ToolStringParam"
            },
            "group": "Group Configuration"
        },
        {
            "key": "group2_name",
            "name": "Name of the second group",
            "required": false,
            "description": "Name of the second group",
            "type": {
                "param_type": "ToolStringParam"
            },
            "group": "Group Configuration"
        },
        {
            "key": "epoch_colors",
            "name": "Epoch Color Palette",
            "required": false,
            "description": "Optional comma-separated matplotlib compatible colors for each epoch (must match epoch_names length when both are provided).",
            "type": {
                "param_type": "ToolStringParam",
                "default": "tab:grey, tab:blue, tab:cyan"
            },
            "group": "Epoch Configuration"
        },
        {
            "key": "group1_color",
            "name": "Color of the first group",
            "required": true,
            "description": "Color of the first group",
            "type": {
                "param_type": "ToolStringParam",
                "default": "tab:blue"
            },
            "group": "Group Configuration"
        },
        {
            "key": "group2_color",
            "name": "Color of the second group",
            "required": false,
            "description": "Color of the second group",
            "type": {
                "param_type": "ToolStringParam",
                "default": "red"
            },
            "group": "Group Configuration"
        },
        {
            "key": "measure_source",
            "name": "Measure Source",
            "required": false,
            "description": "Which data source to analyze: trace, event, or both.",
            "type": {
                "param_type": "ToolChoiceParam",
                "default": "trace",
                "choices": [
                    "trace",
                    "event",
                    "both"
                ],
                "display_options": [
                    "Trace",
                    "Event",
                    "Both"
                ]
            },
            "group": "Analysis Options"
        },
        {
            "key": "correlation_statistic",
            "name": "Correlation Statistic",
            "required": false,
            "description": "Which per-cell correlation statistic to use from correlations CSVs.",
            "type": {
                "param_type": "ToolChoiceParam",
                "default": "max",
                "choices": [
                    "max",
                    "min",
                    "mean"
                ],
                "display_options": [
                    "Max",
                    "Min",
                    "Mean"
                ]
            },
            "group": "Analysis Options"
        },
        {
            "key": "data_pairing",
            "name": "Pairing",
            "required": false,
            "description": "Whether subjects are paired across groups.",
            "type": {
                "param_type": "ToolChoiceParam",
                "default": "unpaired",
                "choices": [
                    "unpaired",
                    "paired"
                ],
                "display_options": [
                    "Unpaired",
                    "Paired"
                ]
            },
            "group": "Analysis Options"
        },
        {
            "key": "subject_matching",
            "name": "Subject Matching",
            "required": false,
            "description": "How to match subjects when pairing is enabled.",
            "type": {
                "param_type": "ToolChoiceParam",
                "default": "order",
                "choices": [
                    "order",
                    "filename"
                ],
                "display_options": [
                    "Input order",
                    "Filename"
                ]
            },
            "group": "Analysis Options"
        },
        {
            "key": "multiple_correction",
            "name": "Multiple Comparison Correction Method",
            "required": true,
            "description": "Method to correct for multiple comparisons",
            "type": {
                "param_type": "ToolChoiceParam",
                "default": "bonf",
                "choices": [
                    "bonf",
                    "fdr_bh",
                    "none"
                ],
                "display_options": [
                    "Bonferroni",
                    "Benjamini-Hochberg FDR",
                    "None"
                ]
            },
            "group": "Statistical Parameters"
        },
        {
            "key": "effect_size",
            "name": "Effect Size Method",
            "required": true,
            "description": "Method to calculate effect size",
            "type": {
                "param_type": "ToolChoiceParam",
                "default": "cohen",
                "choices": [
                    "cohen",
                    "hedges",
                    "r",
                    "eta-square",
                    "odds-ratio",
                    "AUC",
                    "CLES"
                ],
                "display_options": [
                    "Cohen's d",
                    "Hedges' g",
                    "Pearson's r",
                    "Eta-squared",
                    "Odds ratio",
                    "Area under the curve",
                    "Common Language Effect Size"
                ]
            },
            "group": "Statistical Parameters"
        }
    ],
    "results": [
        {
            "key": "activity_group_comparison",
            "name": "Activity Group Comparison",
            "description": "Combined neural activity tables per group.",
            "file_patterns": [
                "group*_combined_activity_data/**/*"
            ]
        },
        {
            "key": "correlation_group_comparison",
            "name": "Correlation Group Comparison",
            "description": "Combined per-cell correlation tables per group.",
            "file_patterns": [
                "group*_combined_trace_correlation_data/**/*"
            ]
        },
        {
            "key": "modulation_group_comparison",
            "name": "Modulation Group Comparison",
            "description": "Combined modulation vs baseline tables per group.",
            "file_patterns": [
                "group*_combined_modulation_data/**/*"
            ]
        },
        {
            "key": "summary_statistics",
            "name": "Summary Statistics",
            "description": "ANOVA-style statistics and pairwise comparisons for trace and event measures.",
            "file_patterns": [
                "trace_aov_comparisons/**/*",
                "trace_pairwise_comparisons/**/*",
                "event_aov_comparisons/**/*",
                "event_pairwise_comparisons/**/*"
            ]
        },
        {
            "key": "lmm_analysis_results",
            "name": "Linear Mixed Model Results",
            "description": "Linear mixed model summaries and pairwise comparisons (generated when save_lmm_outputs=true).",
            "file_patterns": [
                "trace_lmm_comparisons/**/*",
                "trace_lmm_pairwise_comparisons/**/*",
                "event_lmm_comparisons/**/*",
                "event_lmm_pairwise_comparisons/**/*"
            ]
        }
    ],
    "resources": {
        "cpu": 1,
        "gpu": 0,
        "memory": 32000
    },
    "description": "Statistically compare neural activity across epochs between two different groups",
    "visibility": "public",
    "version": "3.0.0",
    "docs": "https://inscopix.github.io/ideas-docs/tools/epochs/comb_comp_epochs__run_cc_epochs/comb_comp_epochs__run_cc_epochs.html",
    "repo": "https://github.com/inscopix/ideas-neural-circuit-analysis",
    "tags": [
        "Neural Circuit Analysis",
        "Study Statistics",
        "Epochs"
    ]
}
